# Freedoom: as variáveis zeradas (.bss) do motor e do código comum vão para a PSRAM. Na RAM
# interna elas tiravam ~90 KB que o launcher precisa (buffer da tela, Wi-Fi). Precisa de
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY (sdkconfig.defaults). Gerado pela lista de
# freedoom/lib/doomgeneric/src/*.c e freedoom/src/comum/*.c: atualize se mudar.
[mapping:freedoom]
archive: libsrc.a
entries:
    if SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        am_map (extram_bss)
        d_event (extram_bss)
        d_items (extram_bss)
        d_iwad (extram_bss)
        d_loop (extram_bss)
        d_main (extram_bss)
        d_mode (extram_bss)
        d_net (extram_bss)
        doomdef (extram_bss)
        doomgeneric (extram_bss)
        doomstat (extram_bss)
        dstrings (extram_bss)
        dummy (extram_bss)
        f_finale (extram_bss)
        f_wipe (extram_bss)
        g_game (extram_bss)
        hu_lib (extram_bss)
        hu_stuff (extram_bss)
        i_cdmus (extram_bss)
        i_endoom (extram_bss)
        i_input (extram_bss)
        i_joystick (extram_bss)
        info (extram_bss)
        i_scale (extram_bss)
        i_sound (extram_bss)
        i_system (extram_bss)
        i_timer (extram_bss)
        m_argv (extram_bss)
        m_bbox (extram_bss)
        m_cheat (extram_bss)
        m_config (extram_bss)
        m_controls (extram_bss)
        memio (extram_bss)
        m_fixed (extram_bss)
        m_menu (extram_bss)
        m_misc (extram_bss)
        m_random (extram_bss)
        p_ceilng (extram_bss)
        p_doors (extram_bss)
        p_enemy (extram_bss)
        p_floor (extram_bss)
        p_inter (extram_bss)
        p_lights (extram_bss)
        p_map (extram_bss)
        p_maputl (extram_bss)
        p_mobj (extram_bss)
        p_plats (extram_bss)
        p_pspr (extram_bss)
        p_saveg (extram_bss)
        p_setup (extram_bss)
        p_sight (extram_bss)
        p_spec (extram_bss)
        p_switch (extram_bss)
        p_telept (extram_bss)
        p_tick (extram_bss)
        p_user (extram_bss)
        r_bsp (extram_bss)
        r_data (extram_bss)
        r_draw (extram_bss)
        r_main (extram_bss)
        r_plane (extram_bss)
        r_segs (extram_bss)
        r_sky (extram_bss)
        r_things (extram_bss)
        sha1 (extram_bss)
        sounds (extram_bss)
        s_sound (extram_bss)
        statdump (extram_bss)
        st_lib (extram_bss)
        st_stuff (extram_bss)
        tables (extram_bss)
        v_video (extram_bss)
        w_checksum (extram_bss)
        w_file (extram_bss)
        w_file_stdc (extram_bss)
        wi_stuff (extram_bss)
        w_main (extram_bss)
        w_wad (extram_bss)
        z_zone (extram_bss)
        entrada (extram_bss)
        i_som (extram_bss)
        i_video (extram_bss)
        doom_glue (extram_bss)
        doom_ui (extram_bss)
